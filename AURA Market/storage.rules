rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images — public read, only superAdmin or companyAdmin can write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superAdmin'
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'companyAdmin'
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // User avatar images — public read, owner can upload (max 2 MB, images only)
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
